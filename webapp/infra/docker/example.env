# OPENAI_API_KEY=sk...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# PERPLEXITYAI_API_KEY=pplx-...
# AWS_BEARER_TOKEN_BEDROCK=...

# CouchDB Credentials for local development
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# --- Observability Settings ---

# To enable AWS CloudWatch logging, provide all four AWS variables below.
# These are for CloudWatch only. The object store takes its credentials
# from S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY -- setting the standard
# AWS names here would make boto3 use them for every AWS call.
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1
# CLOUDWATCH_LOG_GROUP_NAME=gofannon-local-logs

# To enable Google Cloud Logging, set the project ID and ensure your environment
# is authenticated (e.g., via `gcloud auth application-default login`).
# The GOOGLE_CLOUD_PROJECT is also used by Firestore if configured.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id


# --- Database Settings ---

# To enable AWS DynamoDB, provide the AWS keys above and set the table name below.

# DATABASE_PROVIDER=dynamodb
# DYNAMODB_REGION=us-east-1
# DYNAMODB_ENDPOINT_URL=<dynamodb_endpoint_url>
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# --- Memory pilot (services/memory, routes_memory.py) ---
# MEMORY_ENABLED=true
# MEMORY_DOMAINS=dom-scan
# MEMORY_WRITERS=                 # uids allowed to write besides site admins
# MEMORY_S3_BUCKET=               # defaults to S3_BUCKET_NAME
# MEMORY_S3_ROOT=memory/          # entries land at <root>record/<domain>/<id>.md
# MEMORY_RECALL_PROVIDER=llmao
# MEMORY_RECALL_MODEL=qwen3.8-27b

# --- Who may run agent code (ISSUE-023) ---
# Agent code runs inside the API process with its credentials, so the default
# is site admins only. Locally, sign in as the dev stub's site admin, or set
# all_users here to restore the old behaviour.
# AGENT_EXEC_ALLOWED=site_admins       # or all_users
# AGENT_EXEC_ALLOWED_UIDS=             # extra uids allowed, comma-separated, e.g. asf:someone
