# OPENAI_API_KEY=sk...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# PERPLEXITYAI_API_KEY=pplx-...
# AWS_BEARER_TOKEN_BEDROCK=...

# CouchDB Credentials for local development
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
# COUCHDB_TIMEOUT_SECONDS=300          # connect and each read; view queries wait for indexing

# --- Observability Settings ---

# To enable AWS CloudWatch logging, set the region and log group. CloudWatch
# and DynamoDB use boto3's standard credential chain: the instance role on
# EC2, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY elsewhere. On EC2, leave
# the AWS_* keys unset: they override the instance role for every AWS call,
# including Bedrock and the Anthropic federation exchange. The object store
# never uses them; it reads S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
# AWS_DEFAULT_REGION=us-east-1
# CLOUDWATCH_LOG_GROUP_NAME=gofannon-local-logs
# AWS_ACCESS_KEY_ID=your_aws_access_key       # off EC2 only
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key   # off EC2 only

# To enable Google Cloud Logging, set the project ID and ensure your environment
# is authenticated (e.g., via `gcloud auth application-default login`).
# The GOOGLE_CLOUD_PROJECT is also used by Firestore if configured.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id


# --- Database Settings ---

# To enable AWS DynamoDB, set the provider and region. Credentials come from
# the same standard chain as CloudWatch above.

# DATABASE_PROVIDER=dynamodb
# DYNAMODB_REGION=us-east-1
# DYNAMODB_ENDPOINT_URL=<dynamodb_endpoint_url>

# --- Memory pilot (services/memory, routes_memory.py) ---
# MEMORY_ENABLED=true
# MEMORY_DOMAINS=dom-scan
# MEMORY_WRITERS=                 # uids allowed to write besides site admins
# MEMORY_S3_BUCKET=               # defaults to S3_BUCKET_NAME
# MEMORY_S3_ROOT=memory/          # entries land at <root>record/<domain>/<id>.md
# STORAGE_CONNECT_TIMEOUT_SECONDS=10   # object store (S3/SeaweedFS)
# STORAGE_READ_TIMEOUT_SECONDS=60      # wait for the next bytes, not the whole object
# MEMORY_RECALL_PROVIDER=llmao
# MEMORY_RECALL_MODEL=qwen3.8-27b

# --- Who may run agent code (ISSUE-023) ---
# Agent code runs inside the API process with its credentials, so the default
# is site admins only. Locally, sign in as the dev stub's site admin, or set
# all_users here to restore the old behaviour.
# AGENT_EXEC_ALLOWED=site_admins       # or all_users
# AGENT_EXEC_ALLOWED_UIDS=             # extra uids allowed, comma-separated, e.g. asf:someone

# --- LLM call timeouts ---
# LLM_TIMEOUT_SECONDS=600            # total per attempt
# LLM_CONNECT_TIMEOUT_SECONDS=10     # opening the connection (openai/llmao, azure, bedrock)
# LLM_TIMEOUT_RETRIES=2
